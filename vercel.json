{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "x-inertia" }],
      "destination": "https://home-mart-backend.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://home-mart-backend.onrender.com/api/:path*"
    },
    {
      "source": "/mapi/:path*",
      "destination": "https://home-mart-backend.onrender.com/mapi/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://home-mart-backend.onrender.com/storage/:path*"
    },
    {
      "source": "/cart/json",
      "destination": "https://home-mart-backend.onrender.com/cart/json"
    },
    {
      "source": "/passkeys/:path*",
      "destination": "https://home-mart-backend.onrender.com/passkeys/:path*"
    },
    {
      "source": "/settings/passkeys/:path*",
      "destination": "https://home-mart-backend.onrender.com/settings/passkeys/:path*"
    },
    {
      "source": "/settings/payment/setup-intent",
      "destination": "https://home-mart-backend.onrender.com/settings/payment/setup-intent"
    },
    {
      "source": "/user/:path*",
      "destination": "https://home-mart-backend.onrender.com/user/:path*"
    },
    {
      "source": "/notifications",
      "destination": "https://home-mart-backend.onrender.com/notifications"
    },
    {
      "source": "/notifications/:path*",
      "destination": "https://home-mart-backend.onrender.com/notifications/:path*"
    },
    {
      "source": "/chat/:id/messages/since",
      "destination": "https://home-mart-backend.onrender.com/chat/:id/messages/since"
    },
    {
      "source": "/chat/:id/messages/older",
      "destination": "https://home-mart-backend.onrender.com/chat/:id/messages/older"
    },
    {
      "source": "/chat/:id/typing",
      "destination": "https://home-mart-backend.onrender.com/chat/:id/typing"
    },
    {
      "source": "/inbox/:id/messages/since",
      "destination": "https://home-mart-backend.onrender.com/inbox/:id/messages/since"
    },
    {
      "source": "/inbox/:id/messages/older",
      "destination": "https://home-mart-backend.onrender.com/inbox/:id/messages/older"
    },
    {
      "source": "/inbox/:id/typing",
      "destination": "https://home-mart-backend.onrender.com/inbox/:id/typing"
    },
    {
      "source": "/inbox/:id/messages",
      "destination": "https://home-mart-backend.onrender.com/inbox/:id/messages"
    },
    {
      "source": "/chat/:id/messages",
      "destination": "https://home-mart-backend.onrender.com/chat/:id/messages"
    },
    {
      "source": "/region",
      "destination": "https://home-mart-backend.onrender.com/region"
    },
    {
      "source": "/locale",
      "destination": "https://home-mart-backend.onrender.com/locale"
    },
    {
      "source": "/currency",
      "destination": "https://home-mart-backend.onrender.com/currency"
    },
    {
      "source": "/sanctum/csrf-cookie",
      "destination": "https://home-mart-backend.onrender.com/sanctum/csrf-cookie"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://home-mart-backend.onrender.com/auth/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
