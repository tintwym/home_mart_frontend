# Leave empty for local development (Vite proxies to http://localhost:5199)
# and for Vercel production (vercel.json rewrites proxy to Render, same-origin).
# Only set this if the SPA talks to the API on a different origin without a rewrite proxy.
VITE_API_URL=

VITE_APP_NAME=Home Mart

# Firebase Web (Google / Apple sign-in). From Firebase Console → Project settings → Your apps.
# Enable Google and Apple providers; add localhost + production host under Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
